{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --inspect server.js 2>&1 | pino-pretty || nodemon server.js",
    "dev:verbose": "nodemon --verbose --inspect server.js",
    "dev:debug": "DEBUG=* nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:setup": "node src/scripts/setup-database.js",
    "db:reset": "mongosh giro-solidario --eval \"db.dropDatabase()\"",
    "db:reset:force": "node src/scripts/reset-database.js --force",
    "db:seed": "node src/seeders/seed-usuarios.js",
    "db:populate": "node src/scripts/popular-rodada.js",
    "rodada:iniciar": "node src/scripts/iniciar-rodada.js",
    "db:refresh": "npm run db:reset:force && npm run db:setup && npm run db:seed",
    "db:check": "node -e \"const mongoose = require(\"mongoose\"); require(\"dotenv\").config(); async function check() { await mongoose.connect(process.env.MONGODB_URI); const users = await mongoose.connection.db.collection(\"users\").countDocuments(); console.log(\"📊 Usuários no banco:\", users); mongoose.connection.close(); } check();\"",
    "seed:completo": "node src/seeders/seed-completo.js",
    "test:completo": "./test-completo.sh"
  },
  "keywords": [],
  "author": "Seu Nome",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  },
  "description": "Backend do Sistema Giro Premiado"
}
